# Deep check for the vllm venv: the OpenAI server module must import, and the
# installed vLLM must be the one THIS profile asked for.
#
# It used to require a match with the plain `vllm` profile, because this image
# had once been pinned away from the fleet and two images serving the same
# weights on two different vLLMs cost three rounds of misdiagnosis. The two
# images are allowed to evolve apart now; what must never happen is a version
# nobody chose. So the pin is read from this profile's OWN requirements and the
# venv is held to it -- which also catches the resolver quietly substituting a
# different build, the failure the cross-image check could never see.
import pathlib
import vllm.entrypoints.openai.api_server                 # noqa
import torch, vllm
print("vllm", vllm.__version__, "torch", torch.__version__, "cuda", torch.version.cuda)

# Read this profile's own pin rather than restating it here, so the requirement
# and the check cannot disagree.
_want = ""
for _p in ("/tmp/venv-profiles/vllm-ocr.venv-vllm.txt",
           "packaging/runpod/profiles/vllm-ocr.venv-vllm.txt"):
    _f = pathlib.Path(_p)
    if _f.is_file():
        for _line in _f.read_text().splitlines():
            if _line.strip().startswith("vllm=="):
                _want = _line.strip().split("==", 1)[1].split("+")[0]
        break
if _want:
    assert vllm.__version__.startswith(_want), (
        "this venv must serve the vLLM this profile pins (%s); got %s"
        % (_want, vllm.__version__))
    print("vllm matches this profile's pin:", _want)
else:
    print("could not read this profile's vllm pin; version match not enforced here")

# Surya-2 is Qwen3.5-VL, so the architecture has to be in this vLLM's registry or
# the pod cannot serve the model at all. Reported-not-enforced where the registry
# cannot be enumerated: the private table has been renamed before, and failing a
# BUILD on the name of a private symbol would be failing for the wrong reason.
_ARCH = "Qwen3_5ForConditionalGeneration"
try:
    from vllm.model_executor.models import registry as _reg
    _names = set()
    for _attr in ("_MULTIMODAL_MODELS", "_TEXT_GENERATION_MODELS", "_VLLM_MODELS"):
        _names |= set(getattr(_reg, _attr, {}) or {})
    if _names:
        assert _ARCH in _names, "this vLLM cannot serve datalab-to/surya-ocr-2"
        print("registry:", _ARCH, "present")
    else:
        print("registry: could not enumerate architectures on this vLLM; skipped")
except ImportError as exc:
    print("registry: not inspectable (%s); skipped" % exc)
