ARG CORE_BASE=coderai-capability-base-light:latest
ARG PY310_IMAGE=python:3.10-slim

# ---------------------------------------------------------------- venv stage
# The light core is DEBIAN (trixie), where Python 3.10 is not in the archive and the
# deadsnakes PPA does not apply: PPAs are an Ubuntu mechanism and apt here has no
# software-properties-common at all. So the interpreter comes from the official 3.10
# image and the venv is built THERE, where its pip and headers live — the same shape as
# packaging/linux/build_oci_image.sh, which bundles a standalone 3.10 and re-points the
# venv at it.
FROM ${PY310_IMAGE} AS longcatvenv
COPY requirements-longcat.txt /tmp/requirements-longcat.txt
RUN python -m venv /opt/coderai/longcat_venv \
 && /opt/coderai/longcat_venv/bin/python -m pip install -U pip \
 && /opt/coderai/longcat_venv/bin/python -m pip install -r /tmp/requirements-longcat.txt \
 && /opt/coderai/longcat_venv/bin/python -c "import sys,torch,transformers; \
      assert sys.version_info[:2]==(3,10), sys.version; \
      assert torch.__version__.startswith('2.6'), torch.__version__; \
      assert transformers.__version__.startswith('4.41'), transformers.__version__; \
      import accelerate, bitsandbytes" \
 && rm -rf /root/.cache/pip /tmp/requirements-longcat.txt

# ---------------------------------------------------------------- runtime
FROM ${CORE_BASE}

ARG PROFILE=video-longcat
ARG IMAGE_TAG=coderai-video-longcat:latest
ARG LONGCAT_REF=main

# The 3.10 interpreter plus the venv built against it. Copied in this direction because
# a binary linked against the older image's glibc runs on the newer one, not the reverse.
COPY --from=longcatvenv /usr/local /opt/coderai/py310
COPY --from=longcatvenv /opt/coderai/longcat_venv /opt/coderai/longcat_venv

# A copied venv still records the interpreter path of the stage that built it, so its
# bin/python is a dangling symlink here. Re-point it, exactly as the local image does for
# the lip-sync venv, and verify rather than assume.
RUN sed -i 's|^home *=.*|home = /opt/coderai/py310/bin|; \
             s|^command *=.*|command = /opt/coderai/py310/bin/python3.10|' \
        /opt/coderai/longcat_venv/pyvenv.cfg \
 && for p in python python3 python3.10; do \
      ln -sf /opt/coderai/py310/bin/python3.10 "/opt/coderai/longcat_venv/bin/$p"; \
    done \
 && /opt/coderai/longcat_venv/bin/python -c "import sys,torch; \
      assert sys.version_info[:2]==(3,10), sys.version; \
      assert torch.__version__.startswith('2.6'), torch.__version__"

# gcc and libc6-dev are RUNTIME requirements here, not build ones: Triton compiles its
# CUDA driver module the first time it is used, and block-sparse attention (longcat.bsa)
# is pure Triton. Without them a pod fails with "Failed to find C compiler" on the first
# denoising step — the same way Surya did in the local image before v0.2.62.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      ca-certificates \
      gcc \
      libc6-dev \
 && rm -rf /var/lib/apt/lists/*

# The pipeline code. Shallow, no history, no weights, no demo assets.
RUN git clone --depth 1 --branch "${LONGCAT_REF}" \
      https://github.com/meituan-longcat/LongCat-Video /opt/coderai/LongCat-Video \
 && rm -rf /opt/coderai/LongCat-Video/.git /opt/coderai/LongCat-Video/assets \
 && /opt/coderai/longcat_venv/bin/python -c \
      "import sys; sys.path.insert(0,'/opt/coderai/LongCat-Video'); \
       import longcat_video.pipeline_longcat_video"

COPY . /opt/coderai/app
WORKDIR /opt/coderai/app
RUN python -c "import codai.api.app" \
 && python -c "import importlib.util as u; \
      s=u.spec_from_file_location('c','tools/longcat_common.py'); \
      m=u.module_from_spec(s); s.loader.exec_module(m); \
      assert m.source_problems('/opt/coderai/LongCat-Video') == []"

ENV CODERAI_IMAGE_TAG=${IMAGE_TAG} \
    CODERAI_LONGCAT_VENV=/opt/coderai/longcat_venv \
    CODERAI_LONGCAT_SRC=/opt/coderai/LongCat-Video

# The entrypoint. The generic Dockerfile.capability copies this; a custom one has to do
# it too, and forgetting it builds a perfectly good image whose container cannot start.
COPY packaging/runpod/boot.sh /opt/coderai/boot.sh
RUN chmod +x /opt/coderai/boot.sh

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=4)"
CMD ["/opt/coderai/boot.sh"]
