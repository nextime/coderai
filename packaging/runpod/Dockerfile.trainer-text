# syntax=docker/dockerfile:1
#
# The TEXT QLORA TRAINING pod. Not a serving image: this one runs a training
# command and serves no model, which is why it is not one of the
# `Dockerfile.capability-*` family (those run coderai and answer /healthz).
#
# Base: the vLLM image, pinned to the SAME version this repo pins for serving
# (requirements-vllm.txt: vllm==0.27.1). That is not laziness about picking a
# smaller base -- the adapter trained here is served by that vLLM, so training
# and serving get the same torch, the same transformers and above all the same
# tokenizer and chat-template code. A trainer built on a different stack can
# render a prompt the server will not reproduce, and an adapter trained on a
# prompt that is never served is indistinguishable from one that is not applied.
ARG VLLM_TAG=v0.27.1
FROM vllm/vllm-openai:${VLLM_TAG}

# peft + bitsandbytes are what the vLLM image lacks: it serves adapters, it does
# not train them. accelerate for device placement, safetensors for the adapter
# itself (both usually present; named so a thinner future base still works).
#
# tilelang is REMOVED, and this is the line not to delete: its kernels do not
# compile on H100 with CUDA 13, and the failure happens at import time inside
# the training process -- minutes into a rented pod, not at build time. Measured
# the hard way before this file existed.
RUN python3 -m pip install --no-cache-dir \
        "peft>=0.14" "bitsandbytes>=0.50.2" "accelerate>=1.0" "safetensors>=0.4" \
 && python3 -m pip uninstall -y tilelang || true

# coderai's dataset and trainer modules, so the pod can run THIS repo's trainer
# (the masking, the per-example weight scaling, the target selection) rather
# than a copy that drifts from it. Pure Python, no coderai runtime needed.
WORKDIR /opt/trainer
COPY codai/api/text_lora_dataset.py /opt/trainer/codai/api/text_lora_dataset.py
COPY codai/api/text_lora_trainer.py /opt/trainer/codai/api/text_lora_trainer.py
RUN touch /opt/trainer/codai/__init__.py /opt/trainer/codai/api/__init__.py
ENV PYTHONPATH=/opt/trainer

# The runner, BAKED rather than fetched. The image tag then pins the runner
# too, so there is one version to reason about instead of two, and a pod has no
# boot-time dependency on anything outside itself -- fetching it would have
# made an outage at the other end an outage here.
COPY packaging/runpod/text_lora_pod_runner.py /opt/trainer/runner.py

# The vLLM image's ENTRYPOINT is the server itself, which treats every argument
# as a server argument -- so a pod told to run a training command would instead
# start an OpenAI server with nonsense flags and look like a broken image. Reset
# it: this pod runs whatever command it is given.
# The vLLM image's ENTRYPOINT is the server itself, which treats every argument
# as a server argument -- so a pod told to run a training command would instead
# start an OpenAI server with nonsense flags and look like a broken image. Reset
# it, and default to the runner: the orchestrator then needs no start command at
# all, and cannot start a pod that serves nothing.
ENTRYPOINT []
CMD ["python3", "/opt/trainer/runner.py"]

# Deliberately NOT here:
#   * the dataset -- it is content-addressed and fetched per job, so one image
#     serves every run and no training set is baked into a layer that outlives
#     its purpose;
#   * the base weights -- they come from a network volume or the Hub, because a
#     27B base in an image is a 30 GB pull on every cold pod;
#   * credentials of any kind.
