# CoderAI capability pod — a trimmed coderai that serves ONE capability.
#
# The full coderai:base is ~26.6 GB flattened, and a rented pod pays that pull
# before it can answer a single request. A pod that only renders video has no
# use for the STT, OCR, voice-cloning or LLM stacks, so this image installs just
# the profile's dependencies on top of a common core.
#
# It is a normal coderai: the remote gateway talks to it over the same /v1 API,
# and `engine: coderai` pods are ready as soon as /healthz answers.
#
#   docker build -f packaging/runpod/Dockerfile.capability \
#       --build-arg PROFILE=video -t ghcr.io/<you>/coderai-video:latest .
#
# Or use packaging/runpod/build_capability_image.sh, which also smoke-tests the
# result before you push it.

# The shared core (OS + apt + torch + import-time deps). Built once by
# build_capability_image.sh; every profile is FROM it, so all nine images share
# those layers by construction rather than by coincidence.
ARG CORE_BASE=coderai-capability-base:latest
FROM ${CORE_BASE}

ARG PROFILE=images
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu128
ENV PROFILE=${PROFILE}
# Baked at build time so the pod can say WHICH build it is. A machine may serve
# a cached `:latest`, and an images pod once reported a dependency missing that
# had already been published under that tag — with no way to tell from outside
# whether the pod ran the new image or an old one. Now it says so at boot.
ARG IMAGE_TAG=unknown
ENV CODERAI_IMAGE_TAG=${IMAGE_TAG}

WORKDIR /opt/coderai/app
COPY packaging/runpod/profiles/ /tmp/profiles/

# Then only what this capability adds. A profile may ship a `<name>.build-deps`
# listing apt packages its wheels need to COMPILE (deepfilterlib wants a Rust
# toolchain, for one). They are installed and purged inside this single layer, so
# a 1 GB toolchain never ends up in the shipped image.
RUN --mount=type=cache,target=/root/.cache/pip set -eux; \
    deps=""; \
    if [ -f "/tmp/profiles/${PROFILE}.build-deps" ]; then \
        deps="$(grep -vE '^\s*(#|$)' /tmp/profiles/${PROFILE}.build-deps | tr '\n' ' ')"; \
        apt-get update && apt-get install -y --no-install-recommends $deps; \
    fi; \
    python -m pip install --extra-index-url ${TORCH_INDEX} -r /tmp/profiles/${PROFILE}.txt; \
    python -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda)"; \
    if [ -n "$deps" ]; then \
        apt-get purge -y $deps && apt-get autoremove -y; \
    fi; \
    rm -rf /tmp/profiles /var/lib/apt/lists/* /root/.cargo /root/.rustup

# A profile may need a second venv for a library that cannot share the first —
# audiocraft pins torch==2.1.0, which has no build for this image's CUDA. Built
# here rather than on first use: a pod is rented by the second, and installing a
# library during a cold start costs more than carrying the layer.
ARG PROFILE
COPY packaging/runpod/profiles/ /tmp/venv-profiles/
RUN set -eux; \
    extra="/tmp/venv-profiles/${PROFILE}.venv-audiocraft.txt"; \
    if [ -f "$extra" ]; then \
        python -m venv /opt/coderai/venvs/audiocraft; \
        /opt/coderai/venvs/audiocraft/bin/pip install --no-cache-dir -r "$extra"; \
        /opt/coderai/venvs/audiocraft/bin/python -c "import audiocraft; print('audiocraft', audiocraft.__version__)"; \
    fi; \
    rm -rf /tmp/venv-profiles

COPY . /opt/coderai/app

# Fail the BUILD, not the pod, if the profile is missing something the app needs
# to import. A pod that cannot import coderai just never answers /healthz, and
# you find out by watching a boot timeout.
RUN python -c "import codai.api.app; print('coderai imports OK for profile ${PROFILE}')"

EXPOSE 8000
# /healthz is what a `coderai` pod is probed on, and it answers before any model
# is loaded — which is correct: the pod is ready to be asked.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s \
    CMD curl -fsS http://127.0.0.1:8000/healthz || exit 1

COPY packaging/runpod/boot.sh /opt/coderai/boot.sh
RUN chmod +x /opt/coderai/boot.sh

# Not uvicorn directly: boot.sh logs each phase with a timestamp from the first
# instant the container exists, so a slow boot and a failed one stop looking the
# same from outside.
CMD ["/opt/coderai/boot.sh"]
