# syntax=docker/dockerfile:1
# Re-baseline ONLY the GGUF runtime of an already-built coderai image:
# llama-cpp-python rebuilt from source with the RPC backend, plus the
# rpc-server binary from the very same vendored llama.cpp (the RPC protocol
# is versioned — client and server must come from one tree).
#
# The shipped image is a CUDA *runtime* image: no nvcc, no toolchain. So the
# wheel is built in a CUDA devel stage against the same interpreter the image
# runs (python-build-standalone, cp313) and only the wheel and the binary
# cross into the final layer. The CUDA major must match what the image's
# torch and the rest of its llama-cpp-python link (libcudart.so.13 today) —
# CUDA_BUILDER pins that.
#
# Driven by update_oci_image.sh with REBUILD_LLAMA=1 after the ordinary app
# overlay; the result is what flatten_oci_image.sh squashes into coderai:base.
ARG BASE_IMAGE=coderai:dist
ARG CUDA_BUILDER=nvidia/cuda:13.0.2-devel-ubuntu24.04

# ---------------------------------------------------------------- build stage
FROM ${CUDA_BUILDER} AS llamabuild
ARG PYTHON_VERSION=3.13.5
ARG PBS_RELEASE=20250612
# 0.3.30 vendored llama.cpp e3a74b299 (2026-06-16), five weeks BEFORE
# b4aa7dd47 "mtmd : use align_corners for qwen3vl vision position embedding
# interpolation" (#25781, 2026-07-21). Without that fix a qwen3vl projector
# loads, injects its image tokens, and describes every picture identically --
# measured on zeiss 2026-10-30 across two publishers' conversions, with and
# without an image-token floor, while a gemma4v projector read the same images
# correctly through the same code. 0.3.36 vendors 0c1e57098 (2026-10-01), which
# contains it. See docs/serving-a-model-this-box-cannot-hold.md.
ARG LLAMA_CPP_PYTHON_VERSION=0.3.36
# SASS for every card the release may meet (Ampere → Blackwell). sm_86 alone
# is what the local box needs; the GitHub release is for anyone.
ARG CUDA_ARCHS="80;86;89;90;120"
# python-build-standalone was built with clang and says so in its sysconfig
# (CC=clang), which scikit-build then asks CMake for; the builder has gcc.
ENV DEBIAN_FRONTEND=noninteractive FORCE_CMAKE=1 CMAKE_BUILD_PARALLEL_LEVEL=8 MAX_JOBS=8 \
    CC=gcc CXX=g++ CUDAHOSTCXX=g++
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake curl git libgomp1 libvulkan-dev \
      ninja-build pkg-config vulkan-tools glslang-tools glslc spirv-headers spirv-tools \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    curl -fsSL -o /tmp/python.tar.gz \
      "https://github.com/astral-sh/python-build-standalone/releases/download/${PBS_RELEASE}/cpython-${PYTHON_VERSION}+${PBS_RELEASE}-x86_64-unknown-linux-gnu-install_only.tar.gz"; \
    mkdir -p /opt/coderai; tar -xzf /tmp/python.tar.gz -C /opt/coderai; rm /tmp/python.tar.gz
ENV PATH=/opt/coderai/python/bin:$PATH
RUN python3 -m pip install --no-cache-dir -U pip wheel scikit-build-core cmake ninja
RUN --mount=type=cache,target=/root/.cache/pip set -eux; \
    CMAKE_ARGS="-DGGML_CUDA=ON -DGGML_VULKAN=ON -DGGML_RPC=ON -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHS} -DGGML_NATIVE=OFF -DGGML_AVX2=ON" \
      python3 -m pip wheel --no-deps --no-binary llama-cpp-python \
        "llama-cpp-python==${LLAMA_CPP_PYTHON_VERSION}" -w /wheels; \
    python3 -m pip install --no-deps /wheels/llama_cpp_python-*.whl; \
    ls -la /wheels
COPY packaging/build-rpc-server.sh /tmp/build-rpc-server.sh
RUN set -eux; \
    PYTHON=/opt/coderai/python/bin/python3 CMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHS}" \
      bash /tmp/build-rpc-server.sh --cuda --vulkan --dest /wheels; \
    /wheels/rpc-server --help | head -3

# -------------------------------------------------------------- final stage
FROM ${BASE_IMAGE}
COPY --from=llamabuild /wheels/ /tmp/llama-wheels/
RUN set -eux; \
    /opt/coderai/python/bin/python3 -m pip install --no-input --no-cache-dir --no-deps \
        --force-reinstall /tmp/llama-wheels/llama_cpp_python-*.whl; \
    install -m 755 /tmp/llama-wheels/rpc-server /opt/coderai/python/bin/rpc-server; \
    rm -rf /tmp/llama-wheels; \
    # The engines run with LD_LIBRARY_PATH=/opt/coderai/local-libs FIRST, and
    # that beats the wheel's DT_RUNPATH. So the wheel's own libllama.so is
    # loaded by absolute path, and then resolves its libggml-base.so.0 against
    # whatever local-libs holds -- which is the PREVIOUS llama build, because
    # replacing the wheel never touched that directory. Measured 2026-10-30:
    # a 0.3.36 wheel (libggml 0.25.3, libllama 0.5.0) against local-libs'
    # 0.9.7/0.0.8351 gave, in every engine at once,
    #
    #   Failed to load shared library '.../llama_cpp/lib/libllama.so':
    #   undefined symbol: ggml_rope_set_offset
    #
    # i.e. no GGUF serving at all. It stayed hidden because a `docker restart`
    # keeps the container's original image, so the new runtime was never
    # actually executed until the container was recreated.
    #
    # Copy the libs this build produced over the stale ones, so both search
    # paths resolve to the SAME version whatever order they are found in.
    # Orphaned older sonames are left alone: they are harmless once the soname
    # every binary asks for points at the new file, and removing them would
    # break anything else in the bundle still linked to them.
    cp -af /opt/coderai/python/lib/python3.13/site-packages/llama_cpp/lib/libggml*.so* \
           /opt/coderai/python/lib/python3.13/site-packages/llama_cpp/lib/libllama.so* \
           /opt/coderai/python/lib/python3.13/site-packages/llama_cpp/lib/libmtmd.so* \
           /opt/coderai/local-libs/; \
    # The wheel must link against THIS image (its CUDA runtime is on local-libs)
    # and carry the RPC backend. libcuda.so is the driver — present only at run
    # time, mounted by the NVIDIA container runtime — so it is the one library
    # that may legitimately be missing here, and the check is ldd, not import.
    LD_LIBRARY_PATH=/opt/coderai/local-libs:/usr/local/nvidia/lib64 \
      /opt/coderai/python/bin/python3 - <<'PY'
import glob, os, re, subprocess, importlib.util
d = os.path.join(os.path.dirname(importlib.util.find_spec("llama_cpp").origin), "lib")
bad = []
for lib in sorted(glob.glob(d + "/lib*.so")):
    out = subprocess.run(["ldd", lib], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if "not found" in line and not re.search(r"libcuda\.so|libnvidia-ml\.so", line):
            bad.append(f"{os.path.basename(lib)}: {line.strip()}")
assert not bad, "unresolved libraries: " + "; ".join(bad)
names = " ".join(os.path.basename(x) for x in glob.glob(d + "/lib*"))
syms = subprocess.run(["nm", "-D", "--defined-only"] + glob.glob(d + "/libggml*.so"),
                      capture_output=True, text=True).stdout
assert "libggml-rpc" in names or "ggml_backend_rpc" in syms, \
    "RPC backend missing from the rebuilt llama-cpp-python"
print("llama-cpp-python links cleanly and carries the RPC backend: OK")
PY
# Resolve SYMBOLS, not just libraries, along the path the engines really use.
#
# `ldd` answers "can every needed library be found", which both the wheel check
# above and this one asked -- and it is blind to the failure that matters: a
# library that IS found but is the wrong version. The ggml mismatch fixed above
# passed `ldd` cleanly on every file while no engine could load a GGUF.
#
# `ldd -r` performs relocations too, so it names the undefined symbol exactly
# as the runtime would. It runs with LD_LIBRARY_PATH set the way the engines set
# it, because the search ORDER is the whole bug: checking the wheel directory in
# isolation finds a consistent set and proves nothing. Only ggml_/llama_/mtmd_
# symbols are fatal here; libcuda/libnvidia-ml are the driver, mounted by the
# container runtime and absent at build time by definition.
#
# It checks the WHEEL's libllama.so -- the file llama-cpp-python actually
# dlopens by absolute path -- and not local-libs' own copy. That distinction is
# the test: local-libs' old libllama against local-libs' old libggml is a
# self-consistent pair and reports nothing wrong. Checked that way this very
# image, which could not serve a single GGUF, passed with zero findings; checked
# the right way it reported ten, ggml_rope_set_offset among them.
RUN set -eux; \
    LLIB=/opt/coderai/python/lib/python3.13/site-packages/llama_cpp/lib; \
    LD_LIBRARY_PATH=/opt/coderai/local-libs \
      ldd -r "$LLIB/libllama.so" "$LLIB/libmtmd.so" > /tmp/sym.txt 2>&1 || true; \
    if grep -E 'undefined symbol: (ggml|llama|mtmd)_' /tmp/sym.txt; then \
        echo "FATAL: llama/ggml libraries disagree along the engines' own library path" >&2; \
        echo "  (the wheel and /opt/coderai/local-libs are different builds)" >&2; \
        exit 1; \
    fi; \
    rm -f /tmp/sym.txt; \
    echo "llama/ggml symbols resolve under the engines' LD_LIBRARY_PATH: OK"

# Check what it LINKS, not that it runs — the same rule the wheel check above
# states and follows. Executing it here fails on a correctly built binary:
#
#   rpc-server: error while loading shared libraries: libcuda.so.1
#
# libcuda.so.1 is the NVIDIA driver, mounted by the container runtime and so
# absent at build time by definition. The old `--help` invocation only became
# reachable once the build stopped failing earlier (the rpc-server CMake target
# was renamed to ggml-rpc-server upstream), and a CUDA-enabled rpc-server links
# the driver directly — so the first build that got this far could not pass.
#
# Every other dependency must still resolve: a missing libggml or libgomp here
# means a binary that will not start on a real host either.
RUN set -eux; \
    LD_LIBRARY_PATH=/opt/coderai/python/lib:/opt/coderai/local-libs \
      ldd /opt/coderai/python/bin/rpc-server > /tmp/rpc-ldd.txt || true; \
    cat /tmp/rpc-ldd.txt; \
    if grep -v 'libcuda\.so' /tmp/rpc-ldd.txt | grep -q 'not found'; then \
        echo "rpc-server has unresolved libraries other than the driver:" >&2; \
        grep 'not found' /tmp/rpc-ldd.txt >&2; \
        exit 1; \
    fi; \
    rm -f /tmp/rpc-ldd.txt; \
    echo "rpc-server links cleanly (libcuda.so.1 resolves at run time): OK"
