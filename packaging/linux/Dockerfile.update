# Incremental update of an already-built coderai image.
#
# Re-layers ONLY the application code, launcher scripts and service configs on
# top of an existing base image (the heavy bundle: python, venvs, native libs,
# lip-sync, ds4, parler). Those base layers are inherited unchanged — there is no
# 20 GB bundle recopy — so this builds in seconds even with an empty build cache.
#
# Driven by packaging/linux/update_oci_image.sh, which keeps an immutable
# `coderai:base` tag so repeated updates always start from the same bundle and
# never stack app layers on top of each other.
ARG BASE_IMAGE=coderai:base
FROM ${BASE_IMAGE}

# Refresh the app tree plus the scripts/configs that live outside it. The big
# /opt/coderai/{python,*-venv,local-libs,Wav2Lip,SadTalker,ds4,colibri,py310} trees are
# left as inherited layers. (COPY overwrites/adds; a file deleted from the repo
# is pruned by the cleanup RUN below for the known-stale paths.)
COPY . /opt/coderai/app
COPY packaging/linux/launcher/coderai-oci /usr/local/bin/coderai
COPY packaging/linux/launcher/with-env /usr/local/bin/with-env
COPY packaging/linux/launcher/coderai-entrypoint /usr/local/bin/coderai-entrypoint
COPY packaging/linux/launcher/coderai-upgrade /usr/local/bin/coderai-upgrade
COPY packaging/linux/launcher/wav2lip /usr/local/bin/wav2lip
COPY packaging/linux/launcher/sadtalker /usr/local/bin/sadtalker
COPY packaging/linux/nginx.conf /etc/nginx/nginx.conf
COPY packaging/linux/supervisord.conf /etc/supervisor/supervisord.conf
COPY packaging/linux/README-RUN.txt /opt/coderai/README-RUN.txt

RUN set -eux; \
    chmod +x /usr/local/bin/coderai /usr/local/bin/with-env /usr/local/bin/coderai-entrypoint \
             /usr/local/bin/coderai-upgrade \
             /usr/local/bin/wav2lip /usr/local/bin/sadtalker /opt/coderai/app/coderai; \
    mkdir -p /config /models /cache /opt/coderai/app/models; \
    rm -rf \
      /opt/coderai/app/.git \
      /opt/coderai/app/venv* \
      /opt/coderai/app/.venv \
      /opt/coderai/app/township_output \
      /opt/coderai/app/offload \
      /opt/coderai/app/dist \
      /opt/coderai/app/.packaging-cache \
      /opt/coderai/app/.claude \
      /opt/coderai/app/video_editor.config.json \
      /root/.config/Ultralytics/settings.json; \
    find /opt/coderai/app -type d -name __pycache__ -prune -exec rm -rf '{}' +; \
    /opt/coderai/python/bin/python3 -c "import importlib.util, sys; m=[n for n in ('fastapi','uvicorn','torch') if importlib.util.find_spec(n) is None]; sys.exit('base image missing: '+', '.join(m) if m else 0)"

# Context-free GPU memory query dependency (provides `pynvml`). Pure-python and
# tiny, so install it in the overlay too — the base may predate it. The code
# falls back to nvidia-smi when absent, hence `|| true` keeps offline builds OK.
RUN /opt/coderai/python/bin/python3 -m pip install --no-input --no-cache-dir "nvidia-ml-py>=12.0.0" || true

# mDNS cluster discovery (codai/cluster/discovery.py). Small; the code runs
# without it (discovery just stays off), hence `|| true`.
RUN /opt/coderai/python/bin/python3 -m pip install --no-input --no-cache-dir "zeroconf>=0.130" || true

# --no-deps on every one of these, deliberately.
#
# `pip install --target <site-packages>` cannot see what is already installed,
# so it resolves each package's dependency tree from scratch and reinstalls it.
# Measured on the 2026-10-31 build, which pulled in fresh copies of
# typing-extensions, setuptools, triton, sympy, safetensors, tokenizers 0.23.3,
# huggingface-hub 2.4.0, fsspec, filelock, click, python-dateutil and even
# cuda-toolkit, then reported:
#
#   tokenizers 0.22.2 requires huggingface-hub<2.0, but you have 2.4.0
#   datasets 4.8.5 requires fsspec<=2026.2.0, but you have 2026.9.0
#
# i.e. three small additions silently re-pointed the core of the ML stack. That
# is how an image gets a working geoclip and a broken transformers. Every
# dependency these three actually need -- torch, torchvision, huggingface-hub,
# safetensors, numpy, pandas, Pillow -- is already in the bundle, and the two
# that are not (geopy, geographiclib) are named explicitly below.
# Vosk, the CPU STT backend. It is declared in requirements.txt, which the FULL
# build picks up through the pre-built venv bundle -- but this overlay never
# touches the venv, so an image updated incrementally shipped without it and
# every vosk transcription answered
#     Transcription error: No module named 'vosk'
# while /v1/models advertised vosk-en and vosk-it as available. Installed here
# for the same reason nvidia-ml-py and zeroconf are: the overlay has to carry
# what the bundle would have.
#
# Install into the venv's own site-packages explicitly. Installing it the
# ordinary way inside the running container put it in ~/.local instead, because
# the venv is not writable by the container user, and the engine -- which does
# not load the user site -- went on reporting the module as missing while pip
# reported success.
RUN /opt/coderai/python/bin/python3 -m pip install --no-input --no-cache-dir --no-deps \
        --target /opt/coderai/python/lib/python3.13/site-packages \
        "vosk>=0.3.45" || true

# GeoCLIP, for the same reason and in the same way. Declared in requirements.txt
# since the embedder was added, absent from every incrementally-updated image,
# and the two model ids it serves were advertised by /v1/models the whole time:
#
#     POST /v1/embeddings model=geoclip          -> 500
#     POST /v1/embeddings model=geoclip-location -> 500
#
# in half a second, with no load and nothing logged. Both ids share
# _load_geoclip, so one missing import takes out both. geopy and
# geographiclib are its own dependencies and are pure python.
#
# Checked against the built image rather than against requirements.txt --
# a declared dependency the overlay never installs is invisible from the
# source tree, which is what hid this one for as long as it hid vosk.
RUN /opt/coderai/python/bin/python3 -m pip install --no-input --no-cache-dir --no-deps \
        --target /opt/coderai/python/lib/python3.13/site-packages \
        "geoclip>=1.2.0" "geopy>=2.4" "geographiclib>=2.0" || true

# timm, for the same reason and in the same way: declared in requirements.txt
# since the depth/segment endpoints were added, and absent from every
# incrementally-updated image (confirmed by listing the built image's packages,
# not the source tree). It is also a hard requirement of jina-clip-v2, whose
# EVA vision tower IS a timm model, so that embedder cannot load without it.
RUN /opt/coderai/python/bin/python3 -m pip install --no-input --no-cache-dir --no-deps \
        --target /opt/coderai/python/lib/python3.13/site-packages \
        "timm>=1.0.9" || true

# openssh-client so `coderai-docker --upgrade --ssh-key …` can fetch over SSH
# (git is present but the CUDA runtime base ships no ssh). Tiny; keep the overlay
# still fast. `|| true` keeps offline overlay builds working (HTTPS upgrade still
# works without it).
# espeak: the model test run synthesises a spoken sentence to probe an STT
# model with real audio instead of a reachability check. Without it the probe
# degrades silently to "configured, not verified" — caught by inspecting a built
# image, not by any test, because the fallback is deliberately not an error.
# g++: a RUNTIME requirement, like the gcc the base carries for Triton. XTTS's
# Japanese phonemiser (cutlet) pulls mojimoji, a C++ extension with no cp313
# wheel, so it compiles when the isolated TTS venv is built on demand. The
# bundled Python records clang++ as its C++ compiler and no clang is present, so
# the build asked for clang++ and found nothing -- and the image had no C++
# compiler at all: g++, c++ and clang were all absent and /usr/include/c++ did
# not exist, which made gcc's presence look like it covered this. Without it
# XTTS loses exactly one of its seventeen languages.
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client espeak g++ \
    && rm -rf /var/lib/apt/lists/* || true

# Fonts for burned-in captions and overlays (codai/compose): Montserrat and
# Inter are what the caption presets ask for by name, Noto (with CJK) is what
# makes a non-Latin script render as glyphs instead of boxes. The base image
# carried DejaVu only, so a request for "Montserrat" silently got DejaVu.
RUN apt-get update && apt-get install -y --no-install-recommends \
        fontconfig \
        fonts-montserrat fonts-inter fonts-noto-core fonts-noto-cjk fonts-liberation \
    && fc-cache -f >/dev/null 2>&1 \
    && rm -rf /var/lib/apt/lists/* || true

# ENTRYPOINT / EXPOSE / VOLUME / ENV / WORKDIR are inherited from the base image.
