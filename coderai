            "status": "starting",
            "message": "Model starting",
        },
    }
    yield f"data: {json.dumps(data)}\n\n"
    
    try:
        chunk_count = 0
        
        # Debug: Print what is being passed to the model
        if global_debug:
            print(f"\n{'='*80}")
            print(f"=== MODEL INPUT (DEBUG) ===")
