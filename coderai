                                        chunk['choices'][0]['delta']['content'] = content
                                        chunk['choices'][0]['delta']['tool_calls'] = tool_calls
                            
                            yield f"data: {json.dumps(chunk)}\n\n"
                        
                        yield "data: [DONE]\n\n"
                    except Exception as e:
