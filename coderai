            import io
            import numpy as np
            
            # Handle NaN/Inf values in image data - convert to valid values
            if isinstance(img, np.ndarray):
                # Replace NaN and Inf with valid values
                img = np.nan_to_num(img, nan=0.0, posinf=1.0, neginf=0.0)
                # Clip to valid range [0, 1]
